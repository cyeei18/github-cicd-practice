[Unit]
Description=CI/CD Experiment Node Backend
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/srv/cicd-demo/current/backend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /srv/cicd-demo/current/backend/dist/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
